# Neon Postgres connection strings — see https://neon.tech
# Pooled connection (used by the app at runtime via the Neon driver adapter)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct/unpooled connection (used by Prisma CLI for migrations)
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=""

# Web Push (price alert notifications) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret checked by /api/cron/check-alerts — set the same value as a
# GitHub Actions repo secret so the scheduled workflow can call it
CRON_SECRET=""
